// ─── STATE ───────────────────────────────────────────────────
let activeCategory = "all";
let activePrompt   = null;
let searchQuery    = "";

// ─── HELPERS ─────────────────────────────────────────────────
function getCategoryMeta(id) {
  return CATEGORIES.find(c => c.id === id) || {};
}

function getFiltered() {
  const q = searchQuery.toLowerCase();
  return PROMPTS.filter(p => {
    const matchCat  = activeCategory === "all" || p.category === activeCategory;
    const matchText = !q ||
      p.title.toLowerCase().includes(q) ||
      p.description.toLowerCase().includes(q) ||
      p.tags.some(t => t.toLowerCase().includes(q));
    return matchCat && matchText;
  });
}

// ─── SIDEBAR ─────────────────────────────────────────────────
function renderSidebar() {
  const sb = document.getElementById("sidebar");
  // remove old buttons
  sb.querySelectorAll(".cat-btn").forEach(el => el.remove());
  const insertBefore = sb.querySelector(".how-box");

  CATEGORIES.forEach(cat => {
    const count = cat.id === "all"
      ? PROMPTS.length
      : PROMPTS.filter(p => p.category === cat.id).length;

    const btn = document.createElement("button");
    btn.className = "cat-btn" + (cat.id === activeCategory ? " active" : "");
    btn.dataset.catId = cat.id;
    btn.innerHTML = `<span>${cat.icon} ${cat.label}</span><span class="cat-count">${count}</span>`;
    btn.addEventListener("click", () => {
      activeCategory = cat.id;
      renderSidebar();
      renderGrid();
    });
    sb.insertBefore(btn, insertBefore);
  });
}

// ─── GRID ─────────────────────────────────────────────────────
function renderGrid() {
  const grid    = document.getElementById("grid");
  const empty   = document.getElementById("emptyState");
  const status  = document.getElementById("gridStatus");
  const filtered = getFiltered();

  const catLabel = activeCategory === "all"
    ? ""
    : ` in ${getCategoryMeta(activeCategory).label}`;
  const searchLabel = searchQuery ? ` matching "${searchQuery}"` : "";
  status.textContent = `${filtered.length} prompt${filtered.length !== 1 ? "s" : ""}${searchLabel}${catLabel}`;

  grid.innerHTML = "";

  if (filtered.length === 0) {
    empty.style.display = "block";
    return;
  }
  empty.style.display = "none";

  filtered.forEach(p => {
    const cat = getCategoryMeta(p.category);
    const card = document.createElement("div");
    card.className = "card";
    card.setAttribute("tabindex","0");
    card.setAttribute("role","button");
    card.setAttribute("aria-label", p.title);

    const pillsHTML = [
      p.variables.length > 0
        ? `<span class="pill pill-var">${p.variables.length} VAR${p.variables.length !== 1 ? "S" : ""}</span>`
        : "",
      ...p.tags.slice(0,2).map(t => `<span class="pill">${t}</span>`)
    ].join("");

    card.innerHTML = `
      <div class="card-top">
        <span class="card-cat-badge">${cat.icon} ${cat.label}</span>
        <span class="card-arrow">→</span>
      </div>
      <div class="card-title">${p.title}</div>
      <div class="card-desc">${p.description}</div>
      <div class="card-footer">${pillsHTML}</div>`;

    const open = () => openModal(p);
    card.addEventListener("click", open);
    card.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") open(); });
    grid.appendChild(card);
  });
}

// ─── MODAL ───────────────────────────────────────────────────
function buildFilledPrompt(p, vals) {
  let result = p.prompt;
  p.variables.forEach(v => {
    const filled = vals[v] || "";
    result = result.split(`[${v}]`).join(filled || `[${v}]`);
  });
  return result;
}

function renderPromptBox(p, vals) {
  const box = document.getElementById("promptBox");
  let html = p.prompt;
  // highlight unfilled vars
  p.variables.forEach(v => {
    const filled = vals[v] || "";
    if (filled) {
      html = html.split(`[${v}]`).join(`<span class="highlight">${escHTML(filled)}</span>`);
    }
  });
  box.innerHTML = escHTML(p.prompt)
    .split(/\[([A-Z_]+)\]/)
    .map((part, i) => {
      if (i % 2 === 1) {
        const v = part;
        const val = vals[v] || "";
        return val
          ? `<span class="highlight">${escHTML(val)}</span>`
          : `<span style="color:#ff8833;font-style:italic">[${v}]</span>`;
      }
      return part;
    })
    .join("");
}

function escHTML(str) {
  return str
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;");
}

function openModal(p) {
  activePrompt = p;
  const cat = getCategoryMeta(p.category);
  const vals = {};
  p.variables.forEach(v => vals[v] = "");

  document.getElementById("modalEyebrow").textContent = `${cat.icon}  ${cat.label.toUpperCase()}`;
  document.getElementById("modalTitle").textContent   = p.title;
  document.getElementById("modalDesc").textContent    = p.description;

  // variables
  const varsSection = document.getElementById("varsSection");
  const varsGrid    = document.getElementById("varsGrid");
  varsGrid.innerHTML = "";

  if (p.variables.length === 0) {
    varsSection.style.display = "none";
  } else {
    varsSection.style.display = "block";
    p.variables.forEach(v => {
      const wrap = document.createElement("div");
      wrap.className = "var-field";
      wrap.innerHTML = `<label>${v.replace(/_/g," ")}</label>
        <input type="text" placeholder="Enter ${v.toLowerCase().replace(/_/g," ")}" autocomplete="off">`;
      const input = wrap.querySelector("input");
      input.addEventListener("input", () => {
        vals[v] = input.value;
        renderPromptBox(p, vals);
      });
      varsGrid.appendChild(wrap);
    });
  }

  renderPromptBox(p, vals);

  // footer tags
  const ft = document.getElementById("footerTags");
  ft.innerHTML = p.tags.map(t => `<span class="pill">${t}</span>`).join("");

  // copy button state
  const btnCopy = document.getElementById("btnCopy");
  btnCopy.textContent = "COPY PROMPT";
  btnCopy.classList.remove("copied");

  document.getElementById("overlay").classList.add("open");
  document.body.style.overflow = "hidden";
  document.getElementById("modalClose").focus();
}

function closeModal() {
  document.getElementById("overlay").classList.remove("open");
  document.body.style.overflow = "";
  activePrompt = null;
}

// copy handler
document.getElementById("btnCopy").addEventListener("click", () => {
  if (!activePrompt) return;
  const vals = {};
  document.querySelectorAll("#varsGrid .var-field").forEach((wrap, i) => {
    const v = activePrompt.variables[i];
    vals[v] = wrap.querySelector("input").value;
  });
  const text = buildFilledPrompt(activePrompt, vals);
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById("btnCopy");
    btn.textContent = "✓ COPIED";
    btn.classList.add("copied");
    setTimeout(() => { btn.textContent = "COPY PROMPT"; btn.classList.remove("copied"); }, 2200);
  }).catch(() => {
    // fallback for file:// in some browsers
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
    const btn = document.getElementById("btnCopy");
    btn.textContent = "✓ COPIED";
    btn.classList.add("copied");
    setTimeout(() => { btn.textContent = "COPY PROMPT"; btn.classList.remove("copied"); }, 2200);
  });
});

document.getElementById("modalClose").addEventListener("click", closeModal);
document.getElementById("btnCloseFooter").addEventListener("click", closeModal);
document.getElementById("overlay").addEventListener("click", e => {
  if (e.target === document.getElementById("overlay")) closeModal();
});
document.addEventListener("keydown", e => {
  if (e.key === "Escape") closeModal();
});

// search
document.getElementById("searchInput").addEventListener("input", e => {
  searchQuery = e.target.value.trim();
  renderGrid();
});

// ─── INIT ─────────────────────────────────────────────────────
document.getElementById("totalCount").textContent = PROMPTS.length;
renderSidebar();
renderGrid();
</script>
</body>
