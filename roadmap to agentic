<script>
  function navTo(id) {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Sidebar active state
  const sectionIds = ['vision','architecture','flow','phase1','phase2','phase3','phase4','capabilities','mcp','risks','decisions'];

  function updateSidebarActive() {
    let current = sectionIds[0];
    sectionIds.forEach(id => {
      const el = document.getElementById(id) || document.getElementById(id + '-anchor');
      if (el && el.getBoundingClientRect().top < 140) current = id;
    });
    document.querySelectorAll('.sidebar-link').forEach(link => {
      const onclick = link.getAttribute('onclick') || '';
      const match = onclick.match(/navTo\('([^']+)'\)/);
      if (match) link.classList.toggle('active', match[1] === current);
    });
  }

  window.addEventListener('scroll', updateSidebarActive, { passive: true });
  updateSidebarActive();

  // Decision checklist with localStorage persistence
  function toggleDecision(el) {
    el.classList.toggle('checked');
    saveDecisions();
  }

  function saveDecisions() {
    const items = document.querySelectorAll('.decision-item');
    const state = Array.from(items).map(el => el.classList.contains('checked'));
    try { localStorage.setItem('fcip-decisions', JSON.stringify(state)); } catch(e) {}
  }

  function loadDecisions() {
    try {
      const state = JSON.parse(localStorage.getItem('fcip-decisions') || '[]');
      const items = document.querySelectorAll('.decision-item');
      items.forEach((el, i) => { if (state[i]) el.classList.add('checked'); });
    } catch(e) {}
  }

  loadDecisions();
</script>
