<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FCIP Prompt Bank</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,700;1,9..144,300&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root {
    --ink: #0d0f14;
    --paper: #f4f1eb;
    --accent: #c8421a;
    --accent2: #1a5c8a;
    --muted: #8a8478;
    --rule: #d4cfC4;
    --card: #ffffff;
    --tag-bg: #e8e4db;
    --tier1: #2d6a4f;
    --tier2: #1a5c8a;
    --tier3: #7b5e2a;
    --tier4: #6b2d6b;
    --copy-success: #2d6a4f;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'IBM Plex Sans', sans-serif;
    background: var(--paper);
    color: var(--ink);
    min-height: 100vh;
  }

  /* ── HEADER ── */
  header {
    border-bottom: 2px solid var(--ink);
    padding: 2.5rem 3rem 2rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    background: var(--ink);
    color: var(--paper);
    position: relative;
    overflow: hidden;
  }

  header::before {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 300px; height: 300px;
    border-radius: 50%;
    border: 60px solid rgba(200,66,26,0.15);
    pointer-events: none;
  }

  .header-kicker {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  header h1 {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  header h1 span {
    color: var(--accent);
    font-style: italic;
  }

  .header-sub {
    font-size: 0.9rem;
    color: #a8a298;
    margin-top: 0.75rem;
    font-weight: 300;
    max-width: 520px;
  }

  .header-meta {
    text-align: right;
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    color: #a8a298;
    line-height: 1.8;
  }

  .header-meta strong {
    color: var(--paper);
    display: block;
    font-size: 1.1rem;
    font-family: 'Fraunces', serif;
    font-weight: 300;
  }

  /* ── TIER LEGEND ── */
  .tier-legend {
    padding: 1.25rem 3rem;
    border-bottom: 1px solid var(--rule);
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
    background: #f9f7f2;
  }

  .tier-legend-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 0.5rem;
  }

  .tier-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: default;
  }

  .tier-pill.t1 { background: rgba(45,106,79,0.12); color: var(--tier1); }
  .tier-pill.t2 { background: rgba(26,92,138,0.12); color: var(--tier2); }
  .tier-pill.t3 { background: rgba(123,94,42,0.12); color: var(--tier3); }
  .tier-pill.t4 { background: rgba(107,45,107,0.12); color: var(--tier4); }

  .tier-pill::before { content: '●'; font-size: 0.5rem; }

  /* ── CONTROLS ── */
  .controls {
    padding: 1.5rem 3rem;
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    backdrop-filter: blur(4px);
  }

  .search-wrap {
    position: relative;
    flex: 1;
    min-width: 200px;
    max-width: 380px;
  }

  .search-wrap svg {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 0.6rem 0.9rem 0.6rem 2.4rem;
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--ink);
    outline: none;
    transition: border-color 0.2s;
  }

  .search-input:focus { border-color: var(--accent2); }

  .filter-btn {
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    background: var(--card);
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .filter-btn:hover { border-color: var(--ink); color: var(--ink); }
  .filter-btn.active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .result-count {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    margin-left: auto;
  }

  /* ── MAIN LAYOUT ── */
  .layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: calc(100vh - 200px);
  }

  /* ── SIDEBAR ── */
  .sidebar {
    border-right: 1px solid var(--rule);
    padding: 2rem 0;
    position: sticky;
    top: 60px;
    height: calc(100vh - 60px);
    overflow-y: auto;
  }

  .sidebar-section {
    padding: 0 1.25rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 1.5rem;
  }

  .sidebar-section:last-child { border-bottom: none; }

  .sidebar-heading {
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border-radius: 5px;
    font-size: 0.82rem;
    color: var(--ink);
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    font-weight: 400;
  }

  .sidebar-link:hover { background: var(--tag-bg); }
  .sidebar-link.active { background: var(--ink); color: var(--paper); font-weight: 500; }

  .sidebar-link .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── PROMPT GRID ── */
  .prompt-area {
    padding: 2.5rem 3rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .section-title {
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    font-weight: 700;
  }

  .section-count {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .prompt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  /* ── PROMPT CARD ── */
  .prompt-card {
    background: var(--card);
    border: 1.5px solid var(--rule);
    border-radius: 10px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .prompt-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--tier-color, var(--rule));
    border-radius: 10px 10px 0 0;
  }

  .prompt-card:hover {
    border-color: #b8b3a8;
    box-shadow: 0 4px 20px rgba(13,15,20,0.06);
    transform: translateY(-1px);
  }

  .card-meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-title {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    flex: 1;
  }

  .card-tier {
    flex-shrink: 0;
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    padding: 0.25rem 0.6rem;
    border-radius: 20px;
    letter-spacing: 0.04em;
    font-weight: 500;
  }

  .card-desc {
    font-size: 0.82rem;
    color: #555;
    line-height: 1.55;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.62rem;
    padding: 0.2rem 0.55rem;
    background: var(--tag-bg);
    border-radius: 4px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .prompt-text {
    background: #f8f6f1;
    border: 1px solid var(--rule);
    border-radius: 7px;
    padding: 1rem 1.1rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    line-height: 1.65;
    color: #3a3730;
    max-height: 160px;
    overflow: hidden;
    position: relative;
    transition: max-height 0.3s ease;
    white-space: pre-wrap;
  }

  .prompt-text.expanded {
    max-height: 9000px;
  }

  .prompt-text::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 40px;
    background: linear-gradient(transparent, #f8f6f1);
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .prompt-text.expanded::after { opacity: 0; }

  .card-actions {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .btn-copy {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: var(--paper);
    border: none;
    border-radius: 6px;
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.15s;
    font-weight: 500;
  }

  .btn-copy:hover { background: var(--accent); }
  .btn-copy.copied { background: var(--copy-success); }

  .btn-expand {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    background: transparent;
    color: var(--muted);
    border: 1.5px solid var(--rule);
    border-radius: 6px;
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.15s;
  }

  .btn-expand:hover { border-color: var(--ink); color: var(--ink); }

  /* ── CONTEXT REFERENCE CARD ── */
  .context-card {
    background: var(--ink);
    color: var(--paper);
    border-radius: 12px;
    padding: 2rem 2.5rem;
    margin-bottom: 3rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    position: relative;
    overflow: hidden;
  }

  .context-card::after {
    content: 'REF';
    position: absolute;
    right: 2rem; top: 1.5rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.2);
  }

  .context-card h2 {
    font-family: 'Fraunces', serif;
    font-size: 1.4rem;
    font-style: italic;
    font-weight: 300;
    margin-bottom: 0.5rem;
    color: #e8c8a0;
  }

  .context-card p {
    font-size: 0.83rem;
    color: #a8a298;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .context-block {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 7px;
    padding: 1rem 1.1rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.69rem;
    line-height: 1.65;
    color: #c8c0b8;
    max-height: 200px;
    overflow-y: auto;
    white-space: pre-wrap;
  }

  /* ── ROADMAP SECTION ── */
  .roadmap-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.83rem;
    margin-bottom: 3rem;
  }

  .roadmap-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--ink);
    font-family: 'DM Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .roadmap-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  .roadmap-table tr:hover td { background: #f9f7f2; }

  .roadmap-table .item-name {
    font-weight: 500;
    font-family: 'Fraunces', serif;
    font-size: 0.95rem;
  }

  .roadmap-table .item-desc {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  /* ── HIDDEN ── */
  .prompt-card.hidden { display: none; }

  /* ── TOAST ── */
  .toast {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: var(--ink);
    color: var(--paper);
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    transform: translateY(100px);
    opacity: 0;
    transition: all 0.3s ease;
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toast.show { transform: translateY(0); opacity: 1; }

  /* ── SCROLLBAR ── */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: var(--paper); }
  ::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 3px; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    header { padding: 2rem 1.5rem; grid-template-columns: 1fr; }
    .layout { grid-template-columns: 1fr; }
    .sidebar { display: none; }
    .controls { padding: 1rem 1.5rem; }
    .prompt-area { padding: 1.5rem; }
    .prompt-grid { grid-template-columns: 1fr; }
    .context-card { grid-template-columns: 1fr; }
    .tier-legend { padding: 1rem 1.5rem; }
  }

  /* ── NAV LINK BAR ── */
  .nav-bar {
    background: var(--accent);
    color: white;
    padding: 0.6rem 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .nav-bar a {
    color: white;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.9;
    transition: opacity 0.15s;
  }
  .nav-bar a:hover { opacity: 1; }
  @media (max-width: 900px) { .nav-bar { padding: 0.6rem 1.5rem; } }
</style>
</head>
