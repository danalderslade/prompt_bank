    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add('copied');
      btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> COPIED';
      showToast();
      setTimeout(() => {
        btn.classList.remove('copied');
        btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> COPY';
      }, 2500);
    });
  }

  function copyContext() {
    const el = document.getElementById('contextBlock');
    navigator.clipboard.writeText(el.innerText).then(showToast);
  }

  function showToast() {
    const t = document.getElementById('toast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
  }

  function toggleExpand(id, btn) {
    const el = document.getElementById(id);
    const expanded = el.classList.toggle('expanded');
    btn.textContent = expanded ? 'COLLAPSE ↑' : 'EXPAND ↓';
  }

  function filterTier(tier, btn) {
    activeFilter = tier;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
  }

  function filterPrompts() {
    applyFilters();
  }

  function applyFilters() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    const cards = document.querySelectorAll('.prompt-card');
    let visible = 0;

    cards.forEach(card => {
      const tierMatch = activeFilter === 'all' || card.dataset.tier === activeFilter;
      const tags = (card.dataset.tags || '').toLowerCase();
      const title = card.querySelector('.card-title')?.textContent.toLowerCase() || '';
      const desc = card.querySelector('.card-desc')?.textContent.toLowerCase() || '';
      const textMatch = !query || title.includes(query) || desc.includes(query) || tags.includes(query);

      if (tierMatch && textMatch) {
        card.classList.remove('hidden');
        visible++;
      } else {
        card.classList.add('hidden');
      }
    });

    document.getElementById('resultCount').textContent = `${visible} prompt${visible !== 1 ? 's' : ''}`;
  }

  function navTo(id) {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Sidebar active state on scroll
  const sectionIds = ['context','epics','stories','dor','acs','splitting','nfr','backlog','sprint-goal','retro','sprint-planning','roadmap','stakeholder','training','comms'];

  function updateSidebarActive() {
    let current = sectionIds[0];
    sectionIds.forEach(id => {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top < 120) current = id;
    });
    document.querySelectorAll('.sidebar-link').forEach(link => {
      const onclick = link.getAttribute('onclick') || '';
      const match = onclick.match(/navTo\('([^']+)'\)/);
      if (match) link.classList.toggle('active', match[1] === current);
    });
  }

  window.addEventListener('scroll', updateSidebarActive, { passive: true });
  updateSidebarActive();
</script>
</body>
</html>
